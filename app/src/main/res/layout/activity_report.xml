<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E18"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nuevo Reporte"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tipo de Incidente"
        android:textColor="#94A3B8"
        android:layout_marginBottom="4dp"/>

    <!-- Menú sin opción predeterminada -->
    <Spinner
        android:id="@+id/dropTipoCrimen"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#171B26"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Horario del Suceso"
        android:textColor="#94A3B8"
        android:layout_marginBottom="4dp"/>

    <!-- Editable pero se autocompleta con el reloj del celular -->
    <EditText
        android:id="@+id/etHorario"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#171B26"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:hint="Ej: 22:30 hrs"
        android:textColorHint="#475569"
        android:inputType="text"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descripción Adicional (Opcional)"
        android:textColor="#94A3B8"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etDescripcion"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#171B26"
        android:textColor="#FFFFFF"
        android:gravity="top|start"
        android:padding="12dp"
        android:hint="Describa el hecho..."
        android:textColorHint="#475569"
        android:inputType="textMultiLine"
        android:layout_marginBottom="16dp"/>

    <!-- Sector para foto y vista previa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnTomarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#1E293B"
            android:textColor="#38BDF8"
            android:text="📸 Añadir Foto"/>

        <ImageView
            android:id="@+id/ivVistaPreviaFoto"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="#171B26" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Botón Enviar Principal -->
    <Button
        android:id="@+id/btnEnviarReporte"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:backgroundTint="#EF4444"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:text="ENVIAR ALERTA"/>

    <!-- Botón Cancelar debajo del principal -->
    <TextView
        android:id="@+id/btnVolverReporte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center"
        android:text="Cancelar y Volver"
        android:textColor="#94A3B8"
        android:padding="12dp"
        android:layout_marginTop="8dp"/>

</LinearLayout>